#!/bin/bash
# lib/shims/tmux — clikae's tmux guard (CVERInc/clikae#97).
#
# WHY. Twice this month a process that had INHERITED $TMUX from a live tmux
# server ran a destructive verb naming no socket, and it hit the inherited
# server instead of whatever it thought it was isolating:
#
#   2026-09-10  a reviewer's bare `tmux kill-server` (no -L) took down the
#               operator's real server.
#   2026-09-13  a fix lane ran `TMUX_TMPDIR="$T" tmux kill-server`, believing
#               TMUX_TMPDIR isolated it. Socket precedence is
#               -S > -L > $TMUX > TMUX_TMPDIR, and $TMUX (inherited from the
#               cockpit) was set — so it killed the cockpit and 14 running
#               lanes. The lane was resumed from its own transcript and did
#               it again 31 minutes later, same shape.
#
# clikae prepends this shim's directory to PATH in the launch environment of
# every session it starts (lib/core/tmux.sh, tmux_spawn_session — the one
# place a session is created). A sub-agent, a bats run, or any script that
# session goes on to run inherits it for free — nothing to install, nothing
# for a human to remember.
#
# WHAT IT REFUSES. Only a verb that is destructive to the WHOLE inherited
# server or to the CURRENT session on it, and only when $TMUX says a server is
# actually inherited:
#
#   kill-server   with no -S and no -L   — would kill the socket named in $TMUX
#   kill-session  with no -t             — would kill the CURRENT session on it
#
# A human at a plain shell has no $TMUX, so nothing here ever refuses them —
# this only fires for a process that is already INSIDE a tmux session, which
# is exactly the shape both incidents were. -S / -L / -t name a socket or
# session explicitly and always pass through unexamined: naming your target
# is the whole ask, and everything else this shim does not recognise is none
# of its business — it execs straight through.
#
# bash 3.2 (clikae's floor): no arrays, no [[ ]], no ${var,,}, no process
# substitution, no `local` (this is a script, not a sourced function).

set -u

# Resolve the real tmux by walking PATH and skipping every entry that IS this
# file, by identity (`-ef`: same device+inode — survives symlinks and however
# $0 got spelled) rather than a hardcoded /usr/bin/tmux or a directory-string
# comparison. This is the same technique tests/stubs/tmux-guard already proved
# for the same reason: no subshell per PATH entry (a `cd`/`pwd -P` per
# candidate measured ~21ms added to every tmux call — enough to break a
# timing-sensitive test).
#
# 🔴 ALSO STRIP OURSELVES FROM THE PATH WE HAND FORWARD. Self-identity alone
# stops US from calling US — it does nothing about TWO guards leapfrogging
# each other. pty-smoke.py installs its own `tests/stubs/tmux-guard` as
# `tmux` in its sandbox; once this shim's directory lands ahead of it on
# PATH, this shim resolves ITS "real tmux" to that stub (correct: it isn't
# us), execs into it — and that stub does the identical walk, skips only
# ITSELF, finds THIS shim sitting earlier on PATH, decides *that* is the real
# tmux (it isn't ITSELF either), and execs back into us. Neither script did
# anything wrong in isolation; two independent "skip only literally me"
# guards interleaved on PATH is a cycle, and it hung every CI platform's
# pty-smoke job (never a fork bomb here — bash's own exec chain just spun,
# so `new-session` never ran and the socket never existed: "No such file").
# Removing our own directory from $PATH before the exec below means nothing
# downstream — that stub, the reefbox host guard, or a third one someday —
# can ever find us again, no matter what identity check IT uses. The PATH
# handed forward strictly shrinks by at least one entry per hop, so this
# terminates regardless of how many such guards are stacked.
_real_tmux=""
_new_path=""
_ifs_save="$IFS"
IFS=:
for _d in $PATH; do
  IFS="$_ifs_save"
  if [ -n "$_d" ] && [ -x "$_d/tmux" ] && [ "$_d/tmux" -ef "$0" ]; then
    IFS=:
    continue
  fi
  if [ -z "$_real_tmux" ] && [ -n "$_d" ] && [ -x "$_d/tmux" ]; then
    _real_tmux="$_d/tmux"
  fi
  if [ -z "$_new_path" ]; then _new_path="$_d"; else _new_path="$_new_path:$_d"; fi
  IFS=:
done
IFS="$_ifs_save"

if [ -z "$_real_tmux" ]; then
  printf 'tmux-guard: no real tmux found on PATH past this shim\n' >&2
  exit 127
fi

PATH="$_new_path"
export PATH

if [ -n "${TMUX:-}" ]; then
  _sock="${TMUX%%,*}"
  _has_sock=0
  _has_target=0
  _verb=""
  for _a in "$@"; do
    case "$_a" in
      -S|-S*|-L|-L*) _has_sock=1 ;;
      -t|-t*)        _has_target=1 ;;
    esac
  done
  for _a in "$@"; do
    case "$_a" in
      -*) continue ;;
      *)  _verb="$_a"; break ;;
    esac
  done
  case "$_verb" in
    kill-server)
      if [ "$_has_sock" -eq 0 ]; then
        printf 'tmux-guard: refusing bare `tmux kill-server` — $TMUX names a socket (%s) and this would kill its whole server. Name yours: tmux -S <path> kill-server\n' "$_sock" >&2
        exit 86
      fi
      ;;
    kill-session)
      if [ "$_has_target" -eq 0 ]; then
        printf 'tmux-guard: refusing bare `tmux kill-session` — with no -t this kills the CURRENT session on %s. Name yours: tmux kill-session -t <target>\n' "$_sock" >&2
        exit 86
      fi
      ;;
  esac
fi

exec "$_real_tmux" "$@"
