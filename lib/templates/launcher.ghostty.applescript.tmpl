-- clikae Ghostty launcher.
--
-- Ghostty >= 1.3.0 has an AppleScript API, so when Ghostty is ALREADY RUNNING we open the
-- window IN that instance: one Dock icon, and the command rides in a surface configuration
-- (trusted, in-app) so Ghostty never shows its "Allow Ghostty to execute …?" dialog — the
-- dialog only guards the external `-e` path. Object path is window → selected tab →
-- focused terminal; the title is set with the `set_tab_title:` action.
--
-- When Ghostty is NOT running we `open -a` it with the bundled config (a cold start is one
-- instance anyway, and the config carries `title` + `command`). If the AppleScript call fails
-- (Ghostty < 1.3.0, `macos-applescript = false`, or Automation permission denied) we fall back
-- to the old `open -na` path, which still works but shows a second Dock icon.
--
-- macOS asks once, on first launch, whether this .app may control Ghostty (Automation / TCC);
-- click Allow and it's remembered.
--
-- Title + command are read at runtime from Contents/Resources/clikae-ghostty.conf, written by
-- app.sh right after osacompile — one source of truth for both paths. No substitution tokens.
-- `path to me` keeps the launcher working if the .app is moved.

on run
    set confPath to (POSIX path of (path to me)) & "Contents/Resources/clikae-ghostty.conf"
    set theTitle to do shell script "sed -n 's/^title *= *//p' " & quoted form of confPath
    set theCmd to do shell script "sed -n 's/^command *= *//p' " & quoted form of confPath
    if application "Ghostty" is running then
        try
            tell application "Ghostty"
                set cfg to new surface configuration
                set command of cfg to theCmd
                set win to new window with configuration cfg
                delay 0.5
                perform action ("set_tab_title:" & theTitle) on (focused terminal of selected tab of win)
                activate window win
            end tell
            return
        on error
            -- AppleScript unavailable: keep the launcher working, accept the extra Dock icon.
            do shell script "open -na Ghostty.app --args --config-file=" & quoted form of confPath
        end try
    else
        do shell script "open -a Ghostty.app --args --config-file=" & quoted form of confPath
    end if
end run
